# Copy to meet/.env — Vite only reads vars prefixed with VITE_.
# Websocket signaling endpoint — the shared backend's /ws/meet route.
VITE_MEET_WS_URL=ws://localhost:8000/ws/meet
# Google OAuth client ID (Google Cloud Console -> Credentials -> OAuth client
# ID -> Web application). Must match GOOGLE_CLIENT_ID in the backend's .env,
# and http://localhost:5174 must be registered as an authorized JavaScript
# origin for it.
VITE_GOOGLE_CLIENT_ID=
