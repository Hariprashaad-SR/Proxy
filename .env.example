# Copy to .env and fill in. Never commit .env.
# cp .env.example .env

# ---------------------------------------------------------------------------
# App / CORS
# ---------------------------------------------------------------------------
APP_ENV=development
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API — the proxy console (5173)
# and meet app (5174) dev servers by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Postgres (docker compose up -d starts this)
# ---------------------------------------------------------------------------
POSTGRES_USER=proxy
# Local-dev default — fine as-is for running this on your own machine; change
# it if this Postgres is ever reachable from anywhere but localhost.
POSTGRES_PASSWORD=proxy
POSTGRES_DB=proxy
POSTGRES_HOST=localhost
# 5433, not 5432 — avoids silently colliding with a locally-installed
# Postgres (Homebrew, Postgres.app) that may already own 5432.
POSTGRES_PORT=5433
# Leave blank to build the URL from the POSTGRES_* values above; set directly
# to override (e.g. for a managed Postgres instance).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Groq — https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# If the API rejects this model name, list current models at
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Whisper endpoint used to transcribe each participant's live audio.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# Text-to-speech, so Proxy AI can speak its replies, not just type them. The
# model needs one-time terms acceptance per org at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=tara

# ---------------------------------------------------------------------------
# Meet — Google sign-in + the shared websocket signaling endpoint
# (backend/app/routers/meet_ws.py). Used by the `meet` app and by the bot.
# ---------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials
# -> OAuth client ID -> Application type: Web application. Add
# http://localhost:5174 as an Authorized JavaScript origin. Same value goes
# into meet/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Any random string — lets the bot join a meet room without a Google
# account. Keep it out of any frontend .env; only the backend needs it.
BOT_JOIN_SECRET=

# ---------------------------------------------------------------------------
# Bot (backend/app/services/meet_client.py) — joins meet rooms as a WebRTC
# peer of the shared backend, no Google Meet or browser automation involved.
# ---------------------------------------------------------------------------
BOT_DISPLAY_NAME=Proxy AI
# Websocket signaling endpoint the bot connects to. This is the backend's own
# process (ws://localhost:8000/ws/meet works from inside its own container).
MEET_SIGNAL_WS_URL=ws://localhost:8000/ws/meet
# Base URL humans open in a browser to join the bot's room — the `meet` app,
# not `proxy`.
MEET_ROOM_BASE_URL=http://localhost:5174
# Voice-activity detection: buffer each speaker's audio while they're
# actually talking and transcribe once they pause, instead of fixed windows
# that cut mid-word (the main cause of garbled transcripts).
VAD_RMS_THRESHOLD=450
VAD_HANGOVER_MS=600
VAD_MIN_UTTERANCE_MS=400
VAD_MAX_UTTERANCE_MS=12000
MEETING_END_POLL_SECONDS=5
# Consecutive empty-room polls required before Proxy decides everyone left.
MEETING_END_CONFIRM_POLLS=3
# Word Proxy listens for (in speech or chat) before it answers or presents,
# e.g. "Proxy, what did we decide about X?"
TRIGGER_WORD=proxy
# How long each slide of an attached document stays up during the in-call
# walkthrough: word_count * SLIDE_SECONDS_PER_WORD, clamped to
# [SLIDE_MIN_SECONDS, SLIDE_MAX_SECONDS] — a title slide settles at the
# floor, a dense one gets more reading time, nothing runs past the ceiling.
# Runs concurrently with normal Q&A, so this only paces the slides, not
# whether questions get answered.
SLIDE_MIN_SECONDS=20
SLIDE_MAX_SECONDS=90
SLIDE_SECONDS_PER_WORD=0.35

# ---------------------------------------------------------------------------
# Email — sent once the bot leaves a meeting, summarizing it
# ---------------------------------------------------------------------------
# Example for Gmail: smtp.gmail.com, port 587, and an App Password (not your
# normal password) for SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left blank.
SMTP_FROM_EMAIL=
SMTP_USE_TLS=1
# Where meeting summaries get emailed by default (can be overridden per session).
DEFAULT_RECIPIENT_EMAIL=

# ---------------------------------------------------------------------------
# Documents (uploaded concepts Proxy can present / answer from)
# ---------------------------------------------------------------------------
DOCUMENTS_DIR=documents
MAX_UPLOAD_MB=20
# Base URL this backend is reachable at from a browser — used to build the
# image URLs sent to `meet` for rendered PDF pages (PAGES_DIR, served at
# /media). Change this if the backend isn't reachable at localhost from
# wherever `meet` runs (e.g. a non-localhost deployment).
PUBLIC_BACKEND_URL=http://localhost:8000
